# PostgreSQL (docker compose maps host port 5434 -> container 5432; 5432/5433 are taken by other local projects)
POSTGRES_PORT=5434
POSTGRES_DB=ay_movies
POSTGRES_USER=ay_movies
POSTGRES_PASSWORD=ay_movies

DATABASE_URL="postgresql://ay_movies:ay_movies@localhost:5434/ay_movies?schema=public"

# Secret for signing session cookies
SESSION_SECRET="change-me-in-production"

# Production на общем VDS использует Compose PostgreSQL database ay_movies.
# Реальные значения находятся только в /opt/ayurash/env/ay-movies.env.
# DATABASE_URL="postgresql://ay_movies:<secret>@postgres:5432/ay_movies?schema=public"
# WEB_ALLOWED_HOSTS=movies.ayurash.ru

# Production uploads остаются в Timeweb S3.
# S3_ENDPOINT="https://s3.twcstorage.ru"
# S3_REGION="ru-1"
# S3_BUCKET="..."
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
# S3_PUBLIC_URL="https://s3.twcstorage.ru/<bucket>"

# Автозаполнение карточки: Kinopoisk.dev опционален, Wikipedia/Wikidata работает fallback без токенов.
# KINOPOISK_DEV_TOKEN="..."
# KINOPOISK_DEV_BASE_URL="https://api.kinopoisk.dev"
# KINOPOISK_UNOFFICIAL_TOKEN="..."
# KINOPOISK_UNOFFICIAL_BASE_URL="https://kinopoiskapiunofficial.tech"
