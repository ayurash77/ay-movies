    "test:dedupe": "tsx --test scripts/movie-dedupe.test.ts",
    "test:genres": "tsx --test scripts/genre-groups.test.ts",
    "test:merge": "tsx --test scripts/movie-merge.test.ts",
    "test:series-metadata": "tsx --test scripts/series-metadata.test.ts",
    "test:lookup": "tsx --test scripts/movie-lookup.test.ts",
    "test:rich-metadata": "tsx --test scripts/movie-rich-metadata.test.ts",
    "test:people": "tsx --test scripts/people.test.ts",
    "test:reviews": "tsx --test scripts/reviews.test.ts",
    "test:movie-form-flow": "tsx --test scripts/movie-form-flow.test.ts",
    "test:catalog-header": "tsx --test scripts/catalog-header.test.ts",
    "test:movie-navigation-detail": "tsx --test scripts/movie-navigation-detail.test.ts",
